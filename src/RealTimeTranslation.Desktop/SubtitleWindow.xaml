<Window x:Class="RealTimeTranslation.Desktop.SubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时翻译字幕" Width="760" Height="176"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ShowActivated="False"
        ResizeMode="NoResize" SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Background" Value="#44566B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Border Background="#DD17243A" CornerRadius="14" Padding="18,12"
            MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="31" />
                <RowDefinition Height="54" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="#AAC2DB"
                           FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding AreControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}"
                            Style="{StaticResource OverlayButton}" />
                    <Button Content="返回设置" Command="{Binding ReturnToSettingsCommand}"
                            Style="{StaticResource OverlayButton}" />
                    <Button Content="关闭" Command="{Binding CloseCommand}"
                            Style="{StaticResource OverlayButton}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" MouseLeftButtonDown="OnDragAreaMouseDown" Cursor="SizeAll">
                <TextBlock Text="{Binding OriginalText}"
                           FontFamily="Microsoft YaHei UI" FontSize="16" LineHeight="24"
                           LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="48"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOriginalPartial}" Value="True">
                                    <Setter Property="Foreground" Value="#B8C4D4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Grid.Row="2" MouseLeftButtonDown="OnDragAreaMouseDown" Cursor="SizeAll">
                <TextBlock Text="{Binding TranslatedText}" Foreground="White"
                           FontFamily="Microsoft YaHei UI" FontSize="18" FontWeight="SemiBold"
                           LineHeight="26" LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="52" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
