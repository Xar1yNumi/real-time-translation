<Window x:Class="RealTimeTranslation.Desktop.SubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时翻译字幕" Width="760" Height="328"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ShowActivated="False"
        ResizeMode="NoResize" SourceInitialized="OnSourceInitialized"
        DataContextChanged="OnDataContextChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Background" Value="#44566B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Border Background="#E617243A" CornerRadius="14" Padding="18,12"
            MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="OnDragAreaMouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="#AAC2DB"
                           FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding AreControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}"
                            Style="{StaticResource OverlayButton}" />
                    <Button Content="返回设置" Command="{Binding ReturnToSettingsCommand}"
                            Style="{StaticResource OverlayButton}" />
                    <Button Content="关闭" Command="{Binding CloseCommand}"
                            Style="{StaticResource OverlayButton}" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="HistoryScrollViewer" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="OnHistoryScrollChanged">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#385069" BorderThickness="0,0,0,1"
                                    Padding="0,7,12,9">
                                <StackPanel>
                                    <TextBlock Text="{Binding OriginalText}" Foreground="#D1DDEA"
                                               FontFamily="Microsoft YaHei UI" FontSize="14"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TranslatedText}" Foreground="White"
                                               FontFamily="Microsoft YaHei UI" FontSize="18"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#385069" BorderThickness="0,1,0,0"
                    Padding="0,8,10,2"
                    Visibility="{Binding IsOriginalPartial, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding OriginalText}" Foreground="#B8C4D4"
                           FontFamily="Microsoft YaHei UI" FontSize="14"
                           TextWrapping="Wrap" MaxHeight="56" />
            </Border>
        </Grid>
    </Border>
</Window>
